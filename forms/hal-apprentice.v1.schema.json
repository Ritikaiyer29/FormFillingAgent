{
  "schema_id": "hal-kanpur-apprentice",
  "version": "1.0.0-draft",
  "status": "needs_review",
  "source": {
    "document": "forms/HALForm.pdf",
    "pages": {"advertisement": "1-6", "form_a_iti": "7-8", "form_b_vocational": "10-11", "checklists": "7, 9"},
    "extraction": "manual read of rendered pages; to be cross-checked with Sarvam Document Intelligence output"
  },
  "default_language": "Hindi",
  "variants": {
    "ITI": {"label": {"en": "Form-A: ITI trade apprentice", "hi": "प्रपत्र-ए: आई.टी.आई."}},
    "VOCATIONAL": {"label": {"en": "Form-B: Intermediate Vocational (10+2)", "hi": "प्रपत्र-बी: इंटरमीडिएट वोकेशनल (10+2)"}}
  },
  "enums": {
    "gender": [
      {"code": "M", "en": "Male", "hi": "पुरुष"},
      {"code": "F", "en": "Female", "hi": "महिला"},
      {"code": "O", "en": "Other", "hi": "अन्य"}
    ],
    "category": [
      {"code": "SC", "en": "Scheduled Caste", "hi": "अनुसूचित जाति"},
      {"code": "ST", "en": "Scheduled Tribe", "hi": "अनुसूचित जनजाति"},
      {"code": "OBC", "en": "Other Backward Class", "hi": "अन्य पिछड़ा वर्ग"},
      {"code": "PWD", "en": "Physically Handicapped", "hi": "शारीरिक रूप से दिव्यांग"},
      {"code": "EWS", "en": "Economically Weaker Section", "hi": "आर्थिक रूप से कमज़ोर वर्ग"},
      {"code": "GEN", "en": "General Merit", "hi": "सामान्य मेरिट"}
    ],
    "certificate_type": [
      {"code": "NCVT", "en": "NCVT", "hi": "NCVT"},
      {"code": "SCVT", "en": "SCVT", "hi": "SCVT"}
    ],
    "iti_trade": [
      {"code": "FITTER", "en": "Fitter", "hi": "फिटर"},
      {"code": "TURNER", "en": "Turner", "hi": "टर्नर"},
      {"code": "MACHINIST", "en": "Machinist", "hi": "मशीनिष्ट"},
      {"code": "WELDER", "en": "Welder", "hi": "वेल्डर"},
      {"code": "ELECTRONICS_MECHANIC", "en": "Electronics Mechanic", "hi": "इलेक्ट्रॉनिक्स मैकेनिक"},
      {"code": "ELECTRICIAN", "en": "Electrician", "hi": "इलेक्ट्रीशियन"},
      {"code": "INSTRUMENT_MECHANIC", "en": "Instrument Mechanic", "hi": "इन्स्ट्रुमेंट मैकेनिक"},
      {"code": "REFRIGERATOR_AC_MECHANIC", "en": "Refrigerator & A/C Mechanic", "hi": "रेफ्रिजरेटर / एसी मैकेनिक"},
      {"code": "DRAUGHTSMAN_MECHANICAL", "en": "Draughtsman (Mechanical)", "hi": "ड्राफ्टमैन (मैकेनिकल)"},
      {"code": "COPA", "en": "COPA", "hi": "कोपा"},
      {"code": "DRAUGHTSMAN_CIVIL", "en": "Draughtsman (Civil)", "hi": "ड्राफ्टमैन (सिविल)"},
      {"code": "SEWING_TECHNOLOGY", "en": "Sewing Technology", "hi": "सिलाई प्रौद्योगिकी"},
      {"code": "PAINTER", "en": "Painter", "hi": "पेंटर"},
      {"code": "CARPENTER", "en": "Carpenter", "hi": "कारपेंटर"},
      {"code": "AUTOMOBILE_MOTOR_MECHANIC", "en": "Automobile (Motor Mechanic)", "hi": "ऑटोमोबाइल (मोटर मैकेनिक)"}
    ],
    "vocational_subject": [
      {"code": "ACCOUNTANCY", "en": "Accountancy", "hi": "एकाउंटेंसी"},
      {"code": "STENO", "en": "Steno", "hi": "स्टेनो"},
      {"code": "HEALTH_WORKER", "en": "Health Worker", "hi": "हेल्थ वर्कर"},
      {"code": "AUDIO_VISUAL", "en": "Audio Visual", "hi": "ऑडियो विजुअल"},
      {"code": "AUTOMOBILE", "en": "Automobile", "hi": "ऑटोमोबाइल"}
    ]
  },
  "groups": [
    {"id": "identity", "order": 1, "label": {"en": "Personal details", "hi": "व्यक्तिगत विवरण"}},
    {"id": "high_school", "order": 2, "label": {"en": "High school (10th)", "hi": "हाईस्कूल"}},
    {"id": "iti", "order": 3, "when": {"variant": "ITI"}, "label": {"en": "ITI details", "hi": "आईटीआई विवरण"}},
    {"id": "vocational", "order": 3, "when": {"variant": "VOCATIONAL"}, "label": {"en": "Intermediate vocational details", "hi": "इंटरमीडिएट वोकेशनल विवरण"}},
    {"id": "reservation", "order": 4, "label": {"en": "Category and certificates", "hi": "श्रेणी और प्रमाणपत्र"}},
    {"id": "contact", "order": 5, "label": {"en": "Address and contact", "hi": "पता और संपर्क"}},
    {"id": "declaration", "order": 6, "label": {"en": "Declaration", "hi": "घोषणा"}}
  ],
  "fields": [
    {"id": "variant", "group": "identity", "order": 0, "type": "enum", "enum": ["ITI", "VOCATIONAL"], "required": true,
     "label": {"en": "Which application: ITI trade or Intermediate Vocational", "hi": "आवेदन का प्रकार"},
     "ask": "Whether the candidate passed an ITI trade course or Intermediate (12th) vocational course. Decides which form is filled.",
     "confirm": true, "sensitivity": "normal", "infer": false, "transliterate": false},

    {"id": "apprenticeship_reg_no", "group": "identity", "order": 1, "type": "string", "required": true,
     "form_row": {"ITI": 1, "VOCATIONAL": 1},
     "label": {"en": "Apprenticeship registration number", "hi": "अप्रेंटिस पंजीकरण संख्या"},
     "ask": "Registration number from apprenticeshipindia.gov.in (ITI) or RDSDE Kanpur (vocational).",
     "validate": {"pattern": "^[A-Za-z0-9/-]{4,30}$", "normalize": "uppercase_strip_spaces", "format_review": true},
     "confirm": "read_back_by_character", "sensitivity": "identifier", "log": "mask", "infer": false, "transliterate": false},

    {"id": "candidate_name", "group": "identity", "order": 2, "type": "string", "required": true,
     "form_row": {"ITI": 2, "VOCATIONAL": 2},
     "label": {"en": "Candidate name (block letters)", "hi": "उम्मीदवार का नाम"},
     "validate": {"min_len": 2, "max_len": 80, "pattern": "^[\\p{L} .'-]+$", "normalize": "uppercase_latin"},
     "confirm": "spell_on_request", "sensitivity": "personal", "infer": false, "transliterate": "pronunciation"},
    {"id": "father_name", "group": "identity", "order": 3, "type": "string", "required": true,
     "form_row": {"ITI": 3, "VOCATIONAL": 3},
     "label": {"en": "Father's name (block letters)", "hi": "पिता का नाम"},
     "validate": {"min_len": 2, "max_len": 80, "pattern": "^[\\p{L} .'-]+$", "normalize": "uppercase_latin"},
     "confirm": "spell_on_request", "sensitivity": "personal", "infer": false, "transliterate": "pronunciation"},
    {"id": "mother_name", "group": "identity", "order": 4, "type": "string", "required": true,
     "form_row": {"ITI": 4, "VOCATIONAL": 4},
     "label": {"en": "Mother's name (block letters)", "hi": "माता का नाम"},
     "validate": {"min_len": 2, "max_len": 80, "pattern": "^[\\p{L} .'-]+$", "normalize": "uppercase_latin"},
     "confirm": "spell_on_request", "sensitivity": "personal", "infer": false, "transliterate": "pronunciation"},
    {"id": "dob", "group": "identity", "order": 5, "type": "date", "required": true,
     "form_row": {"ITI": 5, "VOCATIONAL": 5},
     "label": {"en": "Date of birth", "hi": "जन्म तिथि"},
     "validate": {"format": "YYYY-MM-DD", "age_rule": "eligibility.age"},
     "confirm": "read_back", "sensitivity": "personal", "infer": false, "transliterate": false},
    {"id": "gender", "group": "identity", "order": 6, "type": "enum", "enum_ref": "gender", "required": true,
     "form_row": {"ITI": 6, "VOCATIONAL": 6},
     "label": {"en": "Gender", "hi": "लिंग"},
     "confirm": false, "sensitivity": "personal", "infer": false, "transliterate": false},
    {"id": "aadhaar_no", "group": "identity", "order": 7, "type": "string", "required": true,
     "form_row": {"ITI": 7, "VOCATIONAL": 7},
     "label": {"en": "Aadhaar number", "hi": "आधार कार्ड संख्या"},
     "ask": "12 digits. Collect in groups of four and read back digit by digit.",
     "validate": {"pattern": "^[2-9][0-9]{11}$", "normalize": "digits_only", "checksum": "verhoeff"},
     "confirm": "read_back_by_digit_groups", "sensitivity": "restricted", "log": "never", "infer": false, "transliterate": false},
    {"id": "pan_no", "group": "identity", "order": 8, "type": "string", "required": true,
     "form_row": {"ITI": 8, "VOCATIONAL": 8},
     "label": {"en": "PAN card number", "hi": "पैनकार्ड संख्या"},
     "validate": {"pattern": "^[A-Z]{5}[0-9]{4}[A-Z]$", "normalize": "uppercase_strip_spaces"},
     "confirm": "read_back_by_character", "sensitivity": "restricted", "log": "never", "infer": false, "transliterate": false},

    {"id": "hs_marks_obtained", "group": "high_school", "order": 1, "type": "number", "required": true,
     "form_row": {"ITI": 9, "VOCATIONAL": 9},
     "label": {"en": "Marks obtained in High School", "hi": "हाईस्कूल में प्राप्तांक"},
     "validate": {"min": 0, "max_ref": "hs_total_marks", "decimals": 2}, "confirm": "read_back", "sensitivity": "personal", "infer": false, "transliterate": false},
    {"id": "hs_total_marks", "group": "high_school", "order": 2, "type": "number", "required": true,
     "form_row": {"ITI": 9, "VOCATIONAL": 9},
     "label": {"en": "Total marks in High School", "hi": "हाईस्कूल पूर्णांक"},
     "validate": {"min": 1, "max": 2000, "decimals": 0}, "confirm": "read_back", "sensitivity": "personal", "infer": false, "transliterate": false},
    {"id": "hs_percentage", "group": "high_school", "order": 3, "type": "number", "required": true, "derived": "100 * hs_marks_obtained / hs_total_marks",
     "form_row": {"ITI": 10, "VOCATIONAL": 10},
     "label": {"en": "Percentage in High School", "hi": "हाईस्कूल में प्राप्त प्रतिशत"},
     "ask": "Never asked. Backend computes to two decimals. If the candidate states a CGPA, ask for converted percentage; per the notice, rounding is not allowed (86.45 stays 86.45).",
     "validate": {"decimals": 2, "no_rounding": true}, "sensitivity": "personal", "infer": "computed", "transliterate": false},

    {"id": "iti_institute", "group": "iti", "order": 1, "type": "string", "required": true, "when": {"variant": "ITI"},
     "form_row": {"ITI": 11},
     "label": {"en": "ITI institute name and address", "hi": "आईटीआई संस्थान का नाम एवं पता"},
     "validate": {"min_len": 5, "max_len": 300}, "confirm": "spell_on_request", "sensitivity": "personal", "infer": false, "transliterate": "pronunciation"},
    {"id": "iti_trade", "group": "iti", "order": 2, "type": "enum", "enum_ref": "iti_trade", "required": true, "when": {"variant": "ITI"},
     "form_row": {"ITI": 12},
     "label": {"en": "ITI trade", "hi": "आईटीआई ट्रेड"},
     "ask": "Listed trades are guidance for classification. Do not read the whole list aloud.",
     "confirm": true, "sensitivity": "normal", "infer": false, "transliterate": false},
    {"id": "iti_pass_year", "group": "iti", "order": 3, "type": "integer", "required": true, "when": {"variant": "ITI"},
     "form_row": {"ITI": 13},
     "label": {"en": "Year of passing ITI", "hi": "आईटीआई उत्तीर्ण वर्ष"},
     "validate": {"allowed": [2023, 2024, 2025], "rule_source": "advertisement clause 1"}, "confirm": true, "sensitivity": "normal", "infer": false, "transliterate": false},
    {"id": "iti_semester_marks", "group": "iti", "order": 4, "type": "repeatable", "when": {"variant": "ITI"},
     "form_row": {"ITI": 14},
     "label": {"en": "ITI marks by semester", "hi": "आईटीआई में प्राप्त अंक"},
     "item_id_prefix": "sem", "min_items": 1, "max_items": 4,
     "item": [
       {"id": "semester", "type": "integer", "validate": {"min": 1, "max": 4}, "required": true},
       {"id": "total", "type": "number", "validate": {"min": 1}, "required": true},
       {"id": "obtained", "type": "number", "validate": {"min": 0, "max_ref": "total"}, "required": true}
     ],
     "ask": "Ask semester by semester only if the candidate has a semester mark sheet. Review needed: confirm with HAL whether 1-year courses leave later semesters blank.",
     "confirm": "read_back", "sensitivity": "personal", "infer": false, "transliterate": false},
    {"id": "iti_percentage", "group": "iti", "order": 5, "type": "number", "required": true, "when": {"variant": "ITI"},
     "derived": "100 * sum(obtained) / sum(total)", "form_row": {"ITI": 15},
     "label": {"en": "Percentage in ITI", "hi": "आईटीआई में प्राप्त प्रतिशत"},
     "ask": "Computed. If the mark sheet shows CGPA, the notice requires the board's converted percentage to two decimals.",
     "validate": {"decimals": 2, "no_rounding": true, "review": "whether to prefer candidate-stated percentage over computed"}, "sensitivity": "personal", "infer": "computed", "transliterate": false},
    {"id": "certificate_type", "group": "iti", "order": 6, "type": "enum", "enum_ref": "certificate_type", "required": true, "when": {"variant": "ITI"},
     "form_row": {"ITI": 16},
     "label": {"en": "Certificate type (NCVT or SCVT)", "hi": "प्रमाणीकरण प्रकार"},
     "confirm": true, "sensitivity": "normal", "infer": false, "transliterate": false},

    {"id": "voc_subject", "group": "vocational", "order": 1, "type": "enum", "enum_ref": "vocational_subject", "required": true, "when": {"variant": "VOCATIONAL"},
     "form_row": {"VOCATIONAL": 11},
     "label": {"en": "Intermediate vocational subject", "hi": "इंटरमीडिएट में वोकेशनल विषय"},
     "confirm": true, "sensitivity": "normal", "infer": false, "transliterate": false},
    {"id": "voc_board", "group": "vocational", "order": 2, "type": "string", "required": true, "when": {"variant": "VOCATIONAL"},
     "form_row": {"VOCATIONAL": 12},
     "label": {"en": "Name of intermediate vocational board", "hi": "बोर्ड का नाम"},
     "validate": {"min_len": 2, "max_len": 120}, "confirm": "spell_on_request", "sensitivity": "normal", "infer": false, "transliterate": "pronunciation"},
    {"id": "voc_pass_year", "group": "vocational", "order": 3, "type": "integer", "required": true, "when": {"variant": "VOCATIONAL"},
     "form_row": {"VOCATIONAL": 13},
     "label": {"en": "Year of passing intermediate vocational", "hi": "उत्तीर्ण वर्ष"},
     "validate": {"allowed": [2023, 2024, 2025], "rule_source": "advertisement clause 2"}, "confirm": true, "sensitivity": "normal", "infer": false, "transliterate": false},
    {"id": "voc_institute", "group": "vocational", "order": 4, "type": "string", "required": true, "when": {"variant": "VOCATIONAL"},
     "form_row": {"VOCATIONAL": 14},
     "label": {"en": "Intermediate institute name and address", "hi": "इंटरमीडिएट संस्थान का नाम एवं पता"},
     "validate": {"min_len": 5, "max_len": 300}, "confirm": "spell_on_request", "sensitivity": "personal", "infer": false, "transliterate": "pronunciation"},
    {"id": "voc_marks_obtained", "group": "vocational", "order": 5, "type": "number", "required": true, "when": {"variant": "VOCATIONAL"},
     "form_row": {"VOCATIONAL": 15},
     "label": {"en": "Marks obtained in intermediate", "hi": "इंटरमीडिएट में प्राप्तांक"},
     "validate": {"min": 0, "max_ref": "voc_total_marks", "decimals": 2}, "confirm": "read_back", "sensitivity": "personal", "infer": false, "transliterate": false},
    {"id": "voc_total_marks", "group": "vocational", "order": 6, "type": "number", "required": true, "when": {"variant": "VOCATIONAL"},
     "form_row": {"VOCATIONAL": 15},
     "label": {"en": "Total marks in intermediate", "hi": "इंटरमीडिएट पूर्णांक"},
     "validate": {"min": 1, "max": 2000, "decimals": 0}, "confirm": "read_back", "sensitivity": "personal", "infer": false, "transliterate": false},
    {"id": "voc_percentage", "group": "vocational", "order": 7, "type": "number", "required": true, "when": {"variant": "VOCATIONAL"},
     "derived": "100 * voc_marks_obtained / voc_total_marks", "form_row": {"VOCATIONAL": 16},
     "label": {"en": "Percentage in intermediate", "hi": "इंटरमीडिएट में प्राप्त प्रतिशत"},
     "ask": "Computed. The Hindi label on Form-B row 16 reads 'subject' (विषय); the English label says percentage. Treated as percentage; flagged for review.",
     "validate": {"decimals": 2, "no_rounding": true}, "sensitivity": "personal", "infer": "computed", "transliterate": false},

    {"id": "caste_name", "group": "reservation", "order": 1, "type": "string", "required": false,
     "form_row": {"ITI": 17, "VOCATIONAL": 17},
     "label": {"en": "Caste", "hi": "जाति"},
     "ask": "Only the community name as on the certificate. Optional for General Merit candidates (review needed).",
     "validate": {"max_len": 60}, "confirm": "spell_on_request", "sensitivity": "sensitive_personal", "infer": false, "transliterate": "pronunciation"},
    {"id": "category", "group": "reservation", "order": 2, "type": "enum", "enum_ref": "category", "required": true,
     "form_row": {"ITI": 18, "VOCATIONAL": 18},
     "label": {"en": "Category", "hi": "श्रेणी"},
     "ask": "Form shows one tick per candidate; treated as single choice. Review needed: PWD candidates may also belong to SC/ST/OBC.",
     "confirm": true, "sensitivity": "sensitive_personal", "infer": false, "transliterate": false},
    {"id": "category_cert_enclosed", "group": "reservation", "order": 3, "type": "boolean", "required": true,
     "when": {"field": "category", "in": ["SC", "ST", "OBC", "PWD", "EWS"]},
     "form_row": {"ITI": 19, "VOCATIONAL": 19},
     "label": {"en": "Self-attested category certificate will be enclosed", "hi": "प्रमाणपत्र संलग्न है"},
     "ask": "Voice cannot attach documents. Records the candidate's statement only; the applicant posts the documents.",
     "confirm": false, "sensitivity": "normal", "infer": false, "transliterate": false},
    {"id": "domicile_cert_enclosed", "group": "reservation", "order": 4, "type": "boolean", "required": true,
     "form_row": {"ITI": 20, "VOCATIONAL": 20},
     "label": {"en": "Domicile certificate issued after 01/01/2023 will be enclosed", "hi": "निवास प्रमाणपत्र संलग्न है"},
     "confirm": false, "sensitivity": "normal", "infer": false, "transliterate": false},

    {"id": "address", "group": "contact", "order": 1, "type": "group", "required": true,
     "form_row": {"ITI": 21, "VOCATIONAL": 21},
     "label": {"en": "Address for communication", "hi": "पत्र-व्यवहार का पता"},
     "ask": "Accept as spoken fragments (house or village, locality, post office, district, state). Form has five free lines plus PIN.",
     "children": [
       {"id": "line1", "type": "string", "required": true, "validate": {"max_len": 100}, "label": {"en": "House / village", "hi": "मकान / गाँव"}},
       {"id": "line2", "type": "string", "required": false, "validate": {"max_len": 100}, "label": {"en": "Locality / post office", "hi": "मोहल्ला / डाकघर"}},
       {"id": "district", "type": "string", "required": true, "validate": {"max_len": 60}, "label": {"en": "District", "hi": "ज़िला"}},
       {"id": "state", "type": "string", "required": true, "validate": {"max_len": 60}, "label": {"en": "State", "hi": "राज्य"}},
       {"id": "pin", "type": "string", "required": true, "validate": {"pattern": "^[1-9][0-9]{5}$", "normalize": "digits_only"}, "label": {"en": "PIN code", "hi": "पिन कोड"}}
     ],
     "confirm": "read_back", "sensitivity": "personal", "infer": false, "enrichment": "none_until_reference_data_approved", "transliterate": "pronunciation"},
    {"id": "mobile", "group": "contact", "order": 2, "type": "string", "required": true,
     "form_row": {"ITI": 22, "VOCATIONAL": 22},
     "label": {"en": "Mobile number", "hi": "मोबाइल"},
     "validate": {"pattern": "^[6-9][0-9]{9}$", "normalize": "digits_only_strip_91"}, "confirm": "read_back_by_digit_groups",
     "sensitivity": "personal", "log": "mask", "infer": false, "transliterate": false, "hint_from_dialed_number": true},
    {"id": "email", "group": "contact", "order": 3, "type": "string", "required": true,
     "form_row": {"ITI": 22, "VOCATIONAL": 22},
     "label": {"en": "Email", "hi": "ई-मेल"},
     "validate": {"format": "email", "normalize": "lowercase"}, "confirm": "spell_by_character",
     "ask": "Candidates may not have an email. Review needed: the notice says a valid email must be registered on the portal, so treated as required.",
     "sensitivity": "personal", "log": "mask", "infer": false, "transliterate": false},
    {"id": "parent_mobile", "group": "contact", "order": 4, "type": "string", "required": true,
     "form_row": {"ITI": 22, "VOCATIONAL": 22},
     "label": {"en": "Parent's mobile number", "hi": "अभिभावक का मोबाइल नं."},
     "validate": {"pattern": "^[6-9][0-9]{9}$", "normalize": "digits_only_strip_91"}, "confirm": "read_back_by_digit_groups",
     "sensitivity": "personal", "log": "mask", "infer": false, "transliterate": false},

    {"id": "declaration_accepted", "group": "declaration", "order": 1, "type": "boolean", "required": true,
     "label": {"en": "Declaration that the information is correct", "hi": "घोषणा"},
     "ask": "Read the declaration once, then obtain an explicit yes. Needs the approved wording; see consent policy.",
     "confirm": "explicit_yes_after_readback", "sensitivity": "normal", "infer": false, "transliterate": false},
