# Sarvam (server-side only; never expose to the frontend)
SARVAM_API_KEY=
# Dedicated secret for signing per-call session capabilities (NOT the Sarvam key)
SESSION_CAPABILITY_SIGNING_SECRET=
SESSION_CAPABILITY_TTL_SECONDS=1800
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/formfilling
# Public HTTPS base URL of the deployed backend (Render)
PUBLIC_BASE_URL=https://example.onrender.com
